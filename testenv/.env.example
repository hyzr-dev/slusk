# Copy to testenv/.env. Never reuse your normal Soulseek account here:
# Soulseek permits only one simultaneous login per account.
SLSKD_SOULSEEK_USERNAME=CHANGE_ME_SLSKD_ACCOUNT
SLSKD_SOULSEEK_PASSWORD=CHANGE_ME
SLSKDARR_SOULSEEK_USERNAME=CHANGE_ME_NATIVE_ACCOUNT
SLSKDARR_SOULSEEK_PASSWORD=CHANGE_ME

# The native soulseek client drives the pipeline by default, since that is the
# backend this lab exists to exercise. Switch to slskd to compare against the
# daemon; both clients log in either way, so their status can be inspected.
SLSKDARR_BACKEND=soulseek
WANTED_ALBUMS=150

# Optional host-side overrides.
TZ=Europe/Stockholm
PUID=1000
PGID=1000
LIDARR_PORT=8686
SLSKD_WEB_PORT=5030
SLSKDARR_PORT=9090
POSTGRES_PORT=15432
SLSKD_LISTEN_PORT=50300
SLSKDARR_LISTEN_PORT=50301

# Fixed local-only integration credentials. Override if desired.
LIDARR_API_KEY=lidarr-pr-lab-api-key-00000001
SLSKD_API_KEY=slskd-pr-lab-api-key-00000001
SLSKD_WEB_USERNAME=slskd
SLSKD_WEB_PASSWORD=slskd
SLSKDARR_OBSERV_TOKEN=slskdarr-pr-lab-observ-token-0001

# Image tags may be pinned here when reproducing an older failure.
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:latest
SLSKD_IMAGE=slskd/slskd:latest
COMPOSE_PROJECT_NAME=slskdarr-pr-lab
