# Secrets — never commit real config with API keys.
# The .* pattern catches editor and hand-made backups (config.toml.bak etc.),
# which the bare name does not.
config.toml
config.toml.*
.env

# Local compose override; the tracked examples are docker-compose.example.yml
# and docker-compose.prod.yml.
docker-compose.yml

# Local database and build artifacts
*.db
*.db-wal
*.db-shm
/slskdarr

# Agent tooling state — local to each developer's machine, not shared.
.serena/

# Vite build output; only the checked-in placeholder index.html is tracked.
/internal/observ/web/dist/*
!/internal/observ/web/dist/placeholder.html
/web/node_modules/
