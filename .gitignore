# Secrets — never commit real config with API keys.
# The .* pattern catches editor and hand-made backups (config.toml.bak etc.),
# which the bare name does not.
config.toml
config.toml.*
.env

# Local compose override; the tracked examples are docker-compose.example.yml
# and docker-compose.prod.yml.
docker-compose.yml

# Local database and build artifacts
*.db
*.db-wal
*.db-shm
/slusk
/testenv/runtime/
/testenv/share/
__pycache__/

# Agent tooling state — local to each developer's machine, not shared.
# These land in the repo root unasked, which is how a blanket `git add -A` once
# swept 278 unrelated files into a commit. Listing them here is the backstop;
# staging explicit paths is still the rule.
.serena/
.pi-subagents/
.remnic/
# Only the worktrees subdirectory: a shared .claude/ config (agents, settings)
# is something this repo may want to track one day, and ignoring the whole
# directory would quietly prevent that.
.claude/worktrees/
# Playwright MCP scratch: console logs and page snapshots from browser-driven
# verification. Written into the repo root by the server, one file per run.
.playwright-mcp/

# Vite build output; only the checked-in placeholder index.html is tracked.
/internal/observ/web/dist/*
!/internal/observ/web/dist/placeholder.html
/web/node_modules/

# Superpowers subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
